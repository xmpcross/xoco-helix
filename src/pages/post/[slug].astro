---
import { getCollection, render } from "astro:content";
import OptimizedImage from "@/components/OptimizedImage.astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  authorSlug,
  categorySlug,
  formatDate,
  getPreviousNext,
  getRelated,
  imageSrc,
  postHref,
  postSlug,
  visiblePosts,
  type Post,
} from "@/lib/posts";
import { siteConfig } from "@/config/site";

export async function getStaticPaths() {
  const allPosts = visiblePosts(await getCollection("posts"));
  return allPosts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, allPosts },
  }));
}

interface Props {
  post: Post;
  allPosts: Post[];
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const data = post.data;
const related = getRelated(allPosts, post, 3);
const { previous, next } = getPreviousNext(allPosts, post);
const articleUrl = new URL(postHref(post), siteConfig.siteUrl).toString();
const absoluteImageUrl = new URL(imageSrc(data.image), siteConfig.siteUrl).toString();
const encodedArticleUrl = encodeURIComponent(articleUrl);
const encodedTitle = encodeURIComponent(data.title);
const encodedEmailBody = encodeURIComponent(`${data.description}\n\n${articleUrl}`);
const tableOfContents = headings.filter(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== "footnote-label",
);
const researchStatusSummary = `This ${data.articleType.toLowerCase()} is labeled ${data.researchStatus.toLowerCase()} by the Helix editorial desk.`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  image: absoluteImageUrl,
  datePublished: data.date.toISOString(),
  dateModified: (data.updatedDate ?? data.date).toISOString(),
  articleSection: data.category,
  author: {
    "@type": "Person",
    name: data.author.name,
    jobTitle: data.author.role,
  },
  publisher: {
    "@type": "Organization",
    name: siteConfig.name,
  },
  mainEntityOfPage: articleUrl,
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={absoluteImageUrl}
  type="article"
  structuredData={structuredData}
>
  <SiteHeader posts={allPosts} />
  <div class="reading-progress" aria-hidden="true"></div>
  <main id="content" class="min-h-screen">
    <article>
      <header class="section-shell pt-9 sm:pt-12">
        <nav class="label-line" aria-label="Breadcrumb">
          <a href="/" class="story-link">Home</a> / <a
            href={`/category/${categorySlug(data.category)}/`}
            class="story-link">{data.category}</a
          >
        </nav>
        <div class="mt-7">
          <h1
            class="font-display text-[clamp(2.35rem,5vw,4.15rem)] font-semibold leading-[1.02] text-balance"
          >
            {data.title}
          </h1>
          <p
            class="mt-5 max-w-[48rem] text-pretty text-[clamp(1.15rem,2vw,1.4rem)] leading-[1.45] text-ink-soft"
          >
            {data.description}
          </p>
        </div>
        <dl class="meta-grid mt-7 max-w-[44rem]">
          <div>
            <dt>Written by</dt>
            <dd>
              <a href={`/author/${authorSlug(data.author.name)}/`} class="story-link"
                >{data.author.name}</a
              >
            </dd>
          </div>
          <div>
            <dt>Published</dt>
            <dd><time datetime={data.date.toISOString()}>{formatDate(data.date, "long")}</time></dd>
          </div>
          {
            data.updatedDate && (
              <div>
                <dt>Updated</dt>
                <dd>
                  <time datetime={data.updatedDate.toISOString()}>
                    {formatDate(data.updatedDate, "long")}
                  </time>
                </dd>
              </div>
            )
          }
          <div>
            <dt>Reading time</dt>
            <dd>{data.readingTime} minutes</dd>
          </div>
        </dl>
        <div class="article-actions-row" aria-label="Article actions">
          <details class="share-menu">
            <summary class="action-control" aria-label="Open sharing options">
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="17"
                height="17"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
              >
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <path d="m8.6 10.6 6.8-4.2"></path>
                <path d="m8.6 13.4 6.8 4.2"></path>
              </svg>
              <span>Share</span>
            </summary>
            <span class="share-options" role="list">
              <a
                href={`https://twitter.com/intent/tweet?url=${encodedArticleUrl}&text=${encodedTitle}`}
                target="_blank"
                rel="noreferrer"
                role="listitem">X</a
              >
              <a
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodedArticleUrl}`}
                target="_blank"
                rel="noreferrer"
                role="listitem">Facebook</a
              >
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedArticleUrl}`}
                target="_blank"
                rel="noreferrer"
                role="listitem">LinkedIn</a
              >
              <a
                href={`https://www.reddit.com/submit?url=${encodedArticleUrl}&title=${encodedTitle}`}
                target="_blank"
                rel="noreferrer"
                role="listitem">Reddit</a
              >
              <a href={`mailto:?subject=${encodedTitle}&body=${encodedEmailBody}`} role="listitem"
                >Email</a
              >
            </span>
          </details>
          <button
            type="button"
            class="action-control"
            data-print-article
            aria-label="Print article"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="17"
              height="17"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
            >
              <path d="M6 9V2h12v7"></path>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
              ></path>
              <path d="M6 14h12v8H6z"></path>
            </svg>
            <span>Print</span>
          </button>
        </div>
      </header>

      <figure class="section-shell mt-9">
        <div class="image-frame aspect-[16/9] max-h-[43rem]">
          <OptimizedImage image={data.image} profile="article" priority />
        </div>
        <figcaption class="mt-3 font-mono text-xs text-muted-foreground">
          Photo credit: {
            data.image.creditUrl ? (
              <a href={data.image.creditUrl} class="story-link" rel="noreferrer">
                {data.image.credit}
              </a>
            ) : (
              data.image.credit
            )
          }
        </figcaption>
      </figure>

      <div
        class="section-shell grid gap-12 pt-11 lg:grid-cols-[minmax(0,44rem)_18rem] lg:justify-center lg:gap-16"
      >
        <div class="min-w-0">
          {
            data.keyFindings.length > 0 && (
              <section class="key-findings" aria-labelledby="key-findings-heading">
                <h2 id="key-findings-heading">Key Findings</h2>
                <ol>
                  {data.keyFindings.map((finding) => (
                    <li>{finding}</li>
                  ))}
                </ol>
              </section>
            )
          }

          <div class="article-body mt-10">
            <Content />
          </div>

          {
            data.sources.length > 0 && (
              <section class="article-backmatter" aria-labelledby="sources-heading">
                <h2 id="sources-heading">Sources and Citations</h2>
                <ul class="citation-list">
                  {data.sources.map((source) => (
                    <li>
                      {source.url ? (
                        <a href={source.url} class="story-link" rel="noreferrer">
                          {source.label}
                        </a>
                      ) : (
                        source.label
                      )}
                      {source.note && <span> - {source.note}</span>}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            data.author.bio && (
              <section class="author-bio" aria-labelledby="author-bio-heading">
                <h2 id="author-bio-heading">{data.author.name}</h2>
                <p class="font-mono text-xs text-muted-foreground">{data.author.role}</p>
                <p class="mt-3 leading-7 text-muted-foreground">{data.author.bio}</p>
              </section>
            )
          }
        </div>

        <aside class="self-start lg:sticky lg:top-24" aria-label="Article context">
          <div class="article-rail grid gap-8">
            <nav aria-labelledby="article-rail-heading">
              <h2 id="article-rail-heading">In This Article</h2>
              <ul class="mt-4 grid gap-3 text-sm text-muted-foreground">
                {
                  data.keyFindings.length > 0 && (
                    <li>
                      <a href="#key-findings-heading" class="story-link">
                        Key findings
                      </a>
                    </li>
                  )
                }
                {
                  tableOfContents.slice(0, 4).map((heading) => (
                    <li class:list={[heading.depth === 3 && "pl-4"]}>
                      <a href={`#${heading.slug}`} class="story-link">
                        {heading.text}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>

            <section aria-labelledby="research-status-heading">
              <h2 id="research-status-heading">Research Status</h2>
              <p class="mt-4 text-sm leading-7 text-muted-foreground">{researchStatusSummary}</p>
              {
                data.doi && (
                  <p class="mt-3 font-mono text-xs text-muted-foreground">DOI: {data.doi}</p>
                )
              }
              {
                data.researchLink && (
                  <a
                    href={data.researchLink}
                    class="story-link mt-3 inline-block font-mono text-xs"
                    rel="noreferrer"
                  >
                    Open research link
                  </a>
                )
              }
            </section>

            <section class="article-sidebar-actions" aria-labelledby="article-actions-heading">
              <h2 id="article-actions-heading">Share</h2>
              <div class="article-actions-row article-actions-row--sidebar">
                <details class="share-menu">
                  <summary class="action-control" aria-label="Open sharing options">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      width="17"
                      height="17"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                    >
                      <circle cx="18" cy="5" r="3"></circle>
                      <circle cx="6" cy="12" r="3"></circle>
                      <circle cx="18" cy="19" r="3"></circle>
                      <path d="m8.6 10.6 6.8-4.2"></path>
                      <path d="m8.6 13.4 6.8 4.2"></path>
                    </svg>
                    <span>Share</span>
                  </summary>
                  <span class="share-options" role="list">
                    <a
                      href={`https://twitter.com/intent/tweet?url=${encodedArticleUrl}&text=${encodedTitle}`}
                      target="_blank"
                      rel="noreferrer"
                      role="listitem">X</a
                    >
                    <a
                      href={`https://www.facebook.com/sharer/sharer.php?u=${encodedArticleUrl}`}
                      target="_blank"
                      rel="noreferrer"
                      role="listitem">Facebook</a
                    >
                    <a
                      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedArticleUrl}`}
                      target="_blank"
                      rel="noreferrer"
                      role="listitem">LinkedIn</a
                    >
                    <a
                      href={`https://www.reddit.com/submit?url=${encodedArticleUrl}&title=${encodedTitle}`}
                      target="_blank"
                      rel="noreferrer"
                      role="listitem">Reddit</a
                    >
                    <a
                      href={`mailto:?subject=${encodedTitle}&body=${encodedEmailBody}`}
                      role="listitem">Email</a
                    >
                  </span>
                </details>
                <button
                  type="button"
                  class="action-control"
                  data-print-article
                  aria-label="Print article"
                >
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    width="17"
                    height="17"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                  >
                    <path d="M6 9V2h12v7"></path>
                    <path
                      d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
                    ></path>
                    <path d="M6 14h12v8H6z"></path>
                  </svg>
                  <span>Print</span>
                </button>
              </div>
            </section>
          </div>
        </aside>
      </div>
    </article>

    {
      (previous || next) && (
        <section class="previous-next-section" aria-label="Previous and next articles">
          <nav class="section-shell grid gap-5 py-12 md:grid-cols-2">
            {previous && (
              <a href={postHref(previous)} class="previous-next-link">
                <span class="label-line">Previous</span>
                <span class="mt-2 block font-display text-xl font-semibold">
                  {previous.data.title}
                </span>
              </a>
            )}
            {next && (
              <a href={postHref(next)} class="previous-next-link md:text-right">
                <span class="label-line">Next</span>
                <span class="mt-2 block font-display text-xl font-semibold">{next.data.title}</span>
              </a>
            )}
          </nav>
        </section>
      )
    }

    <section class="bg-surface" aria-labelledby="related-reporting-heading">
      <div class="section-shell py-[var(--space-section)]">
        <h2 id="related-reporting-heading" class="section-title">Related reporting</h2>
        <div class="mt-7 grid gap-9 md:grid-cols-3">
          {related.map((item) => <PostCard post={item} variant="secondary" headingLevel="h3" />)}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />

  <script is:inline>
    (() => {
      const progress = document.querySelector(".reading-progress");
      const article = document.querySelector("article");
      const shareMenus = [...document.querySelectorAll(".share-menu")];
      const printButtons = document.querySelectorAll("[data-print-article]");
      const updateProgress = () => {
        if (!progress || !article) return;
        const start = article.offsetTop;
        const end = start + article.offsetHeight - window.innerHeight;
        const value =
          end > start ? Math.min(1, Math.max(0, (window.scrollY - start) / (end - start))) : 0;
        progress.style.transform = `scaleX(${value})`;
      };
      updateProgress();
      window.addEventListener("scroll", updateProgress, { passive: true });

      printButtons.forEach((button) => {
        button.addEventListener("click", () => {
          shareMenus.forEach((menu) => menu.removeAttribute("open"));
          window.print();
        });
      });

      document.addEventListener("click", (event) => {
        shareMenus.forEach((menu) => {
          if (menu instanceof HTMLElement && !menu.contains(event.target))
            menu.removeAttribute("open");
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") shareMenus.forEach((menu) => menu.removeAttribute("open"));
      });
    })();
  </script>

  <style>
    .reading-progress {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 90;
      width: 100%;
      height: 3px;
      background: var(--accent-secondary);
      transform: scaleX(0);
      transform-origin: left;
    }

    .share-menu {
      position: relative;
      display: inline-block;
    }

    .article-actions-row {
      display: flex;
      justify-content: flex-end;
      gap: 0.85rem;
      margin-top: 1.1rem;
      font-family: var(--font-mono);
      font-size: 0.74rem;
      color: var(--muted-foreground);
    }

    .action-control {
      display: grid;
      width: 1.45rem;
      height: 1.45rem;
      place-items: center;
      border: 0;
      background: transparent;
      color: var(--muted-foreground);
      cursor: pointer;
      font: inherit;
      list-style: none;
      padding: 0;
      text-align: left;
      transition:
        color 160ms ease,
        transform 160ms ease;
    }

    .action-control span {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .action-control svg {
      width: 1.05rem;
      height: 1.05rem;
    }

    .share-menu summary::-webkit-details-marker {
      display: none;
    }

    .action-control:hover {
      color: var(--accent);
      transform: translateY(-1px);
    }

    .share-options {
      position: absolute;
      top: calc(100% + 0.55rem);
      right: 0;
      z-index: 40;
      min-width: 10rem;
      border: 1px solid var(--border);
      background: var(--surface);
      padding: 0.35rem;
      box-shadow: 0 18px 45px color-mix(in srgb, var(--midnight) 16%, transparent);
    }

    .share-options a,
    .share-options button {
      display: block;
      width: 100%;
      border: 0;
      background: transparent;
      padding: 0.55rem 0.65rem;
      color: var(--foreground);
      font: inherit;
      font-size: 0.9rem;
      line-height: 1.2;
      text-align: left;
      text-decoration: none;
      cursor: pointer;
    }

    .share-options a:hover,
    .share-options button:hover {
      background: var(--muted);
      color: var(--accent);
    }

    .article-actions-row--sidebar {
      justify-content: flex-start;
      margin-top: 1rem;
    }

    .article-actions-row--sidebar .share-options {
      right: auto;
      left: 0;
    }

    @media (min-width: 48rem) {
      .article-actions-row {
        margin-top: -1.45rem;
        min-height: 1.45rem;
      }

      .article-actions-row--sidebar {
        margin-top: 1rem;
      }
    }

    @media (max-width: 47.9375rem) {
      header .article-actions-row {
        justify-content: flex-start;
      }
    }

    .key-findings h2,
    .article-backmatter h2,
    .author-bio h2 {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      line-height: 1.4;
      text-transform: uppercase;
      color: var(--accent);
    }

    .key-findings {
      border-left: 3px solid var(--accent-secondary);
      margin-bottom: 2.5rem;
      padding: 1.1rem 0 1.1rem 1.35rem;
    }

    .key-findings ol {
      margin: 1rem 0 0;
      padding: 0;
      list-style: none;
      line-height: 1.65;
    }

    .key-findings li {
      position: relative;
      margin: 0.75rem 0;
      padding-left: 1.3rem;
    }

    .key-findings li::before,
    .citation-list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.72em;
      width: 0.45rem;
      height: 0.45rem;
      background: var(--accent-secondary);
    }

    .article-rail {
      border-left: 1px solid var(--border);
      padding-left: 1.25rem;
    }

    .article-rail h2 {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      line-height: 1.4;
      text-transform: uppercase;
      color: var(--accent);
    }

    .article-body :global(p),
    .article-body :global(ul),
    .article-body :global(ol) {
      color: color-mix(in srgb, var(--foreground) 88%, transparent);
      font-size: 1.13rem;
      line-height: 1.85;
      text-wrap: pretty;
    }

    .article-body :global(p),
    .article-body :global(ul),
    .article-body :global(ol),
    .article-body :global(figure),
    .article-body :global(blockquote) {
      margin: 1.45rem 0;
    }

    .article-body :global(h2) {
      margin: 3.5rem 0 1rem;
      scroll-margin-top: 6rem;
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 3.2vw, 2.45rem);
      font-weight: 700;
      line-height: 1.12;
      text-wrap: balance;
    }

    .article-body :global(h3) {
      margin: 2.5rem 0 0.8rem;
      scroll-margin-top: 6rem;
      font-family: var(--font-display);
      font-size: clamp(1.35rem, 2vw, 1.65rem);
      font-weight: 700;
      line-height: 1.2;
    }

    .article-body :global(a) {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .article-body :global(blockquote) {
      border-left: 3px solid var(--accent);
      padding: 0.5rem 0 0.5rem 1.25rem;
      font-family: var(--font-display);
      font-size: clamp(1.45rem, 3vw, 2rem);
      font-weight: 700;
      line-height: 1.25;
    }

    .article-body :global(figure) {
      overflow-x: auto;
    }

    .article-body :global(figcaption) {
      margin-top: 0.65rem;
      font-size: 0.9rem;
      line-height: 1.55;
      color: var(--muted-foreground);
    }

    .article-backmatter,
    .author-bio {
      margin-top: 2.5rem;
      border-top: 1px solid var(--border);
      padding-top: 1.25rem;
    }

    .article-backmatter p,
    .author-bio p {
      margin-top: 0.75rem;
      color: var(--muted-foreground);
      line-height: 1.75;
    }

    .citation-list {
      margin-top: 1rem;
      padding-left: 0;
      list-style: none;
      font-size: 0.94rem;
      line-height: 1.7;
      color: var(--muted-foreground);
    }

    .citation-list li {
      position: relative;
      margin-top: 0.75rem;
      padding-left: 1.1rem;
    }

    .citation-list li::before {
      background: var(--accent);
    }

    .article-body :global([data-footnote-ref]) {
      font-family: var(--font-mono);
      font-size: 0.78em;
      color: var(--accent);
      text-decoration: none;
    }

    .article-body :global(.footnotes) {
      margin-top: 3rem;
      border-top: 1px solid var(--border);
      padding-top: 1.25rem;
      color: var(--muted-foreground);
      font-size: 0.9rem;
    }

    .article-body :global(.footnotes h2) {
      position: static;
      width: auto;
      height: auto;
      margin: 0 0 1rem;
      padding: 0;
      overflow: visible;
      clip: auto;
      clip-path: none;
      white-space: normal;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      line-height: 1.4;
      text-transform: uppercase;
      color: var(--accent);
    }

    .article-body :global(.footnotes ol) {
      padding-left: 1.35rem;
      list-style: decimal;
      font-size: inherit;
      line-height: 1.7;
    }

    .article-body :global(.footnotes li) {
      margin-top: 0.75rem;
      padding-left: 0.25rem;
      font-size: inherit;
    }

    .article-body :global(.footnotes li::marker) {
