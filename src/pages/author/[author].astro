---
import { getCollection } from "astro:content";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts, type Post } from "@/lib/posts";

export async function getStaticPaths() {
  const allPosts = visiblePosts(await getCollection("posts"));
  return getAllAuthors(allPosts).map((author) => ({
    params: { author: author.slug },
    props: { author, allPosts },
  }));
}

interface Props {
  author: {
    slug: string;
    name: string;
    role: string;
    bio?: string;
    posts: Post[];
  };
  allPosts: Post[];
}

const { author, allPosts } = Astro.props;
const posts = visiblePosts(allPosts).filter(
  (post) => authorSlug(post.data.author.name) === author.slug,
);
---

<BaseLayout
  title={`${author.name}`}
  description={`Science stories by ${author.name}, ${author.role}, for ${siteConfig.name}.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="min-h-screen">
    <section class="section-shell page-header">
      <p class="page-kicker">Author profile</p>
      <div class="mt-6 grid gap-8 md:grid-cols-[12rem_minmax(0,1fr)] md:items-end">
        <div
          class="grid aspect-square place-items-center bg-primary font-display text-6xl font-semibold text-primary-foreground"
          aria-hidden="true"
        >
          {author.name.charAt(0)}
        </div>
        <div>
          <h1 class="font-display text-[clamp(2.65rem,5.4vw,4.75rem)] font-semibold leading-none">
            {author.name}
          </h1>
          <p class="mt-3 font-mono text-sm text-muted-foreground">{author.role}</p>
          <p class="mt-5 max-w-2xl text-pretty text-lg leading-8 text-muted-foreground">
            {
              author.bio ??
                `${author.name} contributes science reporting and analysis to ${siteConfig.name}.`
            }
          </p>
        </div>
      </div>
    </section>

    <section class="section-shell pb-[var(--space-section)]">
      <h2 class="section-title">Latest work</h2>
      <div class="mt-6 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post, index) => (
            <PostCard post={post} variant={index === 0 ? "field" : "secondary"} eager={index < 2} />
          ))
        }
      </div>
    </section>

    <NewsletterSignup />
  </main>
  <SiteFooter />
</BaseLayout>
